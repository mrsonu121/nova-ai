{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NOVA: Run Django",
      "type": "shell",
      "command": "python manage.py runserver 127.0.0.1:8000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "django",
        "pattern": [{ "regexp": ".*", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching for file changes",
          "endsPattern": "Starting development server at"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    }
  ]
}
